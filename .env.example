# MiniPay environment configuration.
# Copy to .env and fill in values. Never commit .env.

# === Database ===
DATABASE_URL=postgres://minipay:minipay@localhost:5432/minipay?sslmode=disable

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === API Server ===
API_PORT=8080
METRICS_PORT=9090
ADMIN_PORT=8081

# === Security ===
# Admin page HTTP basic auth
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# === Stripe (test mode only, leave empty to disable) ===
# The app refuses to start if this begins with sk_live_
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# === Rate Limiting ===
RATE_LIMIT_CAPACITY=100
RATE_LIMIT_REFILL_PER_SEC=50

# === Risk Rules ===
# Comma-separated list: amount_cap,velocity
RISK_RULES=amount_cap,velocity

# === Fee Configuration ===
FEE_BASIS_POINTS=290
FEE_FIXED_AMOUNT=30

# === Worker ===
OUTBOX_POLL_INTERVAL=200ms
WEBHOOK_ALLOW_PRIVATE=false
WEBHOOK_ALLOW_INSECURE=false

# === Processor ===
# Default processor: simulator or stripe
DEFAULT_PROCESSOR=simulator
